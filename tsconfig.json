{
	"compilerOptions": {
		"allowJs": true,
		"checkJs": false,
		"declaration": false,
		"esModuleInterop": true,
		"lib": ["es2017", "esnext.asynciterable"],
		"module": "commonjs",
		"noImplicitReturns": true,
		"noImplicitAny": false,
		"outDir": "./lib",
		"resolveJsonModule": true,
		"rootDir": "./src",
		"sourceMap": true,
		"skipLibCheck": true,
		"strict": false,
		"target": "es2017",
		"types": ["node"]
	},
	"exclude": [
		"node_modules"
	],
	"include": [
		"src"
	]
}
